import math;
struct Preset {
	key byte[..32] = [],
	label byte[..32] = [],
	bg u32 = 0,
	accent u32 = 0,
	light bool = false,
}
struct Palette {
	bg u32,
	panel u32,
	panel2 u32,
	line u32,
	line2 u32,
	acc u32,
	ink u32,
	soft u32,
	dim u32,
	gold u32,
	err u32,
	ok u32,
	light bool,
}
struct TypeScale {
	telemetry_px f32,
	title_px f32,
	button_px f32,
	body_px f32,
	meta_px f32,
	min_hit_px f32,
	gutter_px f32,
	pad_px f32,
}
var preset_cache Preset[>..];
fn fill_preset_cache() {
	if preset_cache.len == 0 {
		let rows = preset_rows();
		preset_cache.append(rows);
	}
}
fn presets() Preset[>..] {
	fill_preset_cache();
	copy(preset_cache)
}
fn preset_rows() Preset[>..] {
	var r Preset[>..] = [];
	r.push(Preset{"amni_dark", "Amni", 0xFF0A0A0A, 0xFF00FF9D, false});
	r.push(Preset{"amni_light", "Amni Light", 0xFFF4F4F4, 0xFF00875A, true});
	r.push(Preset{"haven", "Haven", 0xFF191B28, 0xFF7C5CFC, false});
