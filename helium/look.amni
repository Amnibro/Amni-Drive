	r.push(Preset{"ffx", "FFX", 0xFF080E1A, 0xFF40A8E0, false});
	r.push(Preset{"gospel", "Gospel", 0xFFF5F0E8, 0xFF8B2032, true});
	r.push(Preset{"halo", "Halo", 0xFF0D1A0D, 0xFFD4A020, false});
	r.push(Preset{"holo", "Holo", 0xFF000000, 0xFF33B5E5, false});
	r.push(Preset{"ice", "Ice", 0xFF0A1520, 0xFF00D4FF, false});
