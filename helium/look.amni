	r.push(Preset{"amni_ai", "Amni AI", 0xFF0A0A0A, 0xFFFFB74D, false});
	r.push(Preset{"amni_calc", "Amni Calc", 0xFF0A0A0A, 0xFFFF6B35, false});
	r.push(Preset{"core", "Core", 0xFF0A0A0A, 0xFFEF5350, false});
	r.push(Preset{"crypt", "Crypt", 0xFF0A0A0A, 0xFF2979FF, false});
	r.push(Preset{"explore", "Explore", 0xFF0A0A0A, 0xFF00B4FF, false});
	r.push(Preset{"high_contrast", "High Contrast", 0xFF000000, 0xFFFFFF00, false});
	r.push(Preset{"oled", "OLED Black", 0xFF000000, 0xFF00E5FF, false});
	r.push(Preset{"night_red", "Night Red", 0xFF0A0000, 0xFFFF3B30, false});
	r.push(Preset{"night_amber", "Night Amber", 0xFF0A0700, 0xFFFFA000, false});
	r.push(Preset{"abyss", "Abyss", 0xFF040810, 0xFF1A5AFF, false});
	r.push(Preset{"bloodborne", "Bloodborne", 0xFF0A0000, 0xFFCC0020, false});
	r.push(Preset{"braid", "Braid", 0xFF0B0D12, 0xFF00FF9D, false});
	r.push(Preset{"braid_light", "Braid Light", 0xFFF7F7F8, 0xFF00875A, true});
	r.push(Preset{"chapel", "Chapel", 0xFF0E0C18, 0xFF8A5CF0, false});
	r.push(Preset{"crt", "CRT", 0xFF080808, 0xFFFFB000, false});
	r.push(Preset{"cyberpunk", "Cyberpunk", 0xFF0A0A12, 0xFFFF2D6F, false});
	r.push(Preset{"darksouls", "Dark Souls", 0xFF0C0A08, 0xFFC8A84E, false});
	r.push(Preset{"discord", "Discord", 0xFF313338, 0xFF5865F2, false});
	r.push(Preset{"dracula", "Dracula", 0xFF1A1B26, 0xFFBD93F9, false});
	r.push(Preset{"eldenring", "Elden Ring", 0xFF08080E, 0xFFD4A832, false});
