fn is_digit(b byte) bool {
	b >= '0' && b <= '9'
}
fn is_email_char(b byte) bool {
	is_digit(b) || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '.' || b == '_' || b == '%' || b == '+' || b == '-'
}
fn email_end(line const byte[:], i int) int {
	var at = i;
	while at < line.len && is_email_char(line[at]) { at++; }
	if at == i || at >= line.len || line[at] != '@' { return -1; }
	var end = at + 1;
	while end < line.len && is_email_char(line[end]) { end++; }
	while end > at + 1 && (line[end - 1] == '.' || line[end - 1] == '-') { end -= 1; }
	var k = at + 2;
	while k < end {
		if line[k] == '.' { return end; }
		k++;
	}
	-1
}
fn has_prefix(line const byte[:], i int, prefix const byte[:]) bool {
	if i + prefix.len > line.len { return false; }
	for k in prefix.len {
		var c = line[i + k];
		if c >= 'A' && c <= 'Z' { c += 32; }
		if c != prefix[k] { return false; }
	}
	true
}
fn is_blank(b byte) bool {
	b == ' ' || b == '\t' || b == '\r' || b == '\n'
}
fn secret_prefix_len(line const byte[:], i int) int {
	if has_prefix(line, i, "bearer ") { return 7; }
	if has_prefix(line, i, "token=") { return 6; }
	if has_prefix(line, i, "cookie=") { return 7; }
	0
}
fn secret_end(line const byte[:], from int) int {
	var end = from;
	while end < line.len && !is_blank(line[end]) { end++; }
	end
}
fn digits_end(line const byte[:], from int) int {
	var end = from;
	while end < line.len && is_digit(line[end]) { end++; }
	end
}
fn ip_end(line const byte[:], i int) int {
	if i > 0 && is_digit(line[i - 1]) { return -1; }
	var p = i;
	for group in 4 {
		if group > 0 {
			if p >= line.len || line[p] != '.' { return -1; }
			p++;
		}
		let q = digits_end(line, p);
		if q == p || q - p > 3 { return -1; }
		p = q;
	}
	p
}
fn coord_end(line const byte[:], from int) int {
	var p = from;
	if p < line.len && (line[p] == '-' || line[p] == '+') { p++; }
	let dot = digits_end(line, p);
	if dot == p || dot >= line.len || line[dot] != '.' { return -1; }
	let end = digits_end(line, dot + 1);
	if end - dot - 1 < 3 { return -1; }
	end
}
fn gps_end(line const byte[:], i int) int {
	if i > 0 && is_digit(line[i]) && is_digit(line[i - 1]) { return -1; }
	let first = coord_end(line, i);
	if first < 0 { return -1; }
	var p = first;
	while p < line.len && line[p] == ' ' { p++; }
	if p < line.len && line[p] == ',' { p++; }
	while p < line.len && line[p] == ' ' { p++; }
	coord_end(line, p)
}
fn phone_end(line const byte[:], i int) int {
	let head = line[i];
	if !(is_digit(head) || head == '+' || head == '(') { return -1; }
	if i > 0 && is_digit(head) && is_digit(line[i - 1]) { return -1; }
	var p = if head == '+' { i + 1 } else { i };
	var count = 0;
	var gap = 0;
	var end = -1;
	while p < line.len {
		let c = line[p];
		if is_digit(c) {
			count++;
			gap = 0;
			end = p + 1;
		} else if (c == '-' || c == ' ' || c == '(' || c == ')') && gap < 2 {
			gap++;
		} else {
			break;
		}
		p++;
	}
	if count == 10 || count == 11 { return end; }
	-1
}
fn scrub_line(line const byte[:]) byte[>..] {
	var out byte[>..] = [];
	var i = 0;
	while i < line.len {
		let mail = email_end(line, i);
		if mail >= 0 {
			out.append("[EMAIL]");
			i = mail;
			continue;
		}
		let skip = secret_prefix_len(line, i);
		if skip > 0 {
			let stop = secret_end(line, i + skip);
			if stop > i + skip {
				out.append(line[i..i + skip]);
				out.append("[TOKEN]");
				i = stop;
				continue;
			}
		}
		let ip = ip_end(line, i);
		if ip >= 0 {
			out.append("[IP]");
			i = ip;
			continue;
		}
		let gps = gps_end(line, i);
		if gps >= 0 {
			out.append("[GPS]");
			i = gps;
			continue;
		}
		let phone = phone_end(line, i);
		if phone >= 0 {
			out.append("[PHONE]");
			i = phone;
			continue;
		}
		out.push(line[i]);
		i++;
	}
	out
}
fn scrub_text(text const byte[:]) byte[>..] {
	var out byte[>..] = [];
	var start = 0;
	for i in text.len {
		if text[i] == '\n' {
			let cleaned = scrub_line(text[start..i]);
			out.append(cleaned);
			out.push('\n');
			start = i + 1;
		}
	}
	let tail = scrub_line(text[start..text.len]);
	out.append(tail);
	out
}
