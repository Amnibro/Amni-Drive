struct Rect { x f32, y f32, w f32, h f32 }
struct Circle { cx f32, cy f32, r f32 }
struct HitButton { id i32, rect Rect, primary bool }
struct Pod { kind i32, shape i32, rect Rect, circle Circle, cutout Circle, safe_rect Rect, chamfer f32 }
struct CockpitPlan { screen_w f32, screen_h f32, layout_id i32, dock_rect Rect, stage_rect Rect, portrait bool, dock_bottom bool, buttons HitButton[..8], pods Pod[..8] }
fn make_rect(x f32, y f32, w f32, h f32) Rect {
	Rect { x: x, y: y, w: w, h: h }
}
fn rects_overlap(a Rect, b Rect) bool {
	let ox f32 = min(a.x + a.w, b.x + b.w) - max(a.x, b.x);
	let oy f32 = min(a.y + a.h, b.y + b.h) - max(a.y, b.y);
	ox > 0.5 && oy > 0.5
}
fn rect_inside(inner Rect, outer Rect) bool {
	inner.w > 0.0 && inner.h > 0.0 && inner.x >= outer.x - 0.5 && inner.y >= outer.y - 0.5 && inner.x + inner.w <= outer.x + outer.w + 0.5 && inner.y + inner.h <= outer.y + outer.h + 0.5
}
fn inscribe_circle(r Rect) Circle {
	Circle { cx: r.x + r.w * 0.5, cy: r.y + r.h * 0.5, r: min(r.w, r.h) * 0.5 }
}
fn circle_safe_rect(c Circle) Rect {
	let side f32 = c.r * 1.4142;
	make_rect(c.cx - side * 0.5, c.cy - side * 0.5, side, side)
}
fn make_pod(kind i32, shape i32, r Rect, cutout Circle) Pod {
	var pod = Pod { kind: kind, shape: shape, rect: r, circle: Circle { cx: 0.0, cy: 0.0, r: 0.0 }, cutout: cutout, safe_rect: r, chamfer: 0.0 };
	if shape == 1 {
		pod.circle = inscribe_circle(r);
		pod.safe_rect = circle_safe_rect(pod.circle);
	} else if shape == 2 {
		pod.chamfer = clamp(min(r.w, r.h) * 0.07, 12.0, 24.0);
		let inset f32 = pod.chamfer * 0.55;
		pod.safe_rect = make_rect(r.x + inset, r.y + inset, r.w - 2.0 * inset, r.h - 2.0 * inset);
	} else if shape == 3 {
		pod.chamfer = min(min(r.w, r.h) * 0.28, 44.0);
		let inset_x f32 = min(r.w * 0.08, pod.chamfer * 0.5);
		pod.safe_rect = make_rect(r.x + inset_x, r.y + 8.0, r.w - 2.0 * inset_x, r.h - 16.0);
	} else if shape == 5 {
		pod.chamfer = 24.0;
		let left_clear f32 = max(r.x + 12.0, cutout.cx + cutout.r + 12.0);
		pod.safe_rect = make_rect(left_clear, r.y + 16.0, max(40.0, r.x + r.w - left_clear - 14.0), max(40.0, r.h - 32.0));
	} else if shape == 4 {
		pod.chamfer = 24.0;
		let right_clear f32 = min(r.x + r.w - 12.0, cutout.cx - cutout.r - 12.0);
		pod.safe_rect = make_rect(r.x + 14.0, r.y + 16.0, max(40.0, right_clear - (r.x + 14.0)), max(40.0, r.h - 32.0));
	} else if shape == 6 {
		pod.chamfer = 24.0;
		let top_clear f32 = max(r.y + 12.0, cutout.cy + cutout.r + 14.0);
		pod.safe_rect = make_rect(r.x + 18.0, top_clear, max(40.0, r.w - 36.0), max(40.0, r.y + r.h - top_clear - 16.0));
	}
	pod
}
fn cockpit_add_pod(plan CockpitPlan&, kind i32, shape i32, x f32, y f32, w f32, h f32) {
	plan.pods.push(make_pod(kind, shape, make_rect(x, y, w, h), Circle { cx: 0.0, cy: 0.0, r: 0.0 }));
}
fn cockpit_add_cut(plan CockpitPlan&, kind i32, shape i32, x f32, y f32, w f32, h f32, cutout Circle) {
	plan.pods.push(make_pod(kind, shape, make_rect(x, y, w, h), cutout));
}
fn cockpit_add_chips(plan CockpitPlan&, right f32, y f32, g f32) {
	cockpit_add_pod(plan, 2, 3, right - 188.0 - g, y, 94.0, 44.0);
	cockpit_add_pod(plan, 3, 3, right - 94.0, y, 94.0, 44.0);
}
fn compute_cockpit(screen_w f32, screen_h f32, min_hit f32, gutter f32, edge_pad f32, layout_id i32, dock_mode i32, swap_map_media bool) CockpitPlan {
	let portrait = screen_h > screen_w * 1.05;
	let dock_bottom = portrait || dock_mode == 1;
	var dock = make_rect(0.0, 0.0, 0.0, 0.0);
	var stage = make_rect(0.0, 0.0, 0.0, 0.0);
	if dock_bottom {
		let dock_h f32 = min(max(min_hit + 8.0, 66.0), screen_h * 0.15);
		dock = make_rect(edge_pad, screen_h - dock_h - edge_pad, screen_w - 2.0 * edge_pad, dock_h);
		stage = make_rect(edge_pad, edge_pad, screen_w - 2.0 * edge_pad, screen_h - dock_h - 2.0 * edge_pad - gutter);
	} else {
		let dock_w f32 = min(max(min_hit + 12.0, 74.0), screen_w * 0.12);
		if dock_mode == 2 {
			dock = make_rect(screen_w - dock_w - edge_pad, edge_pad, dock_w, screen_h - 2.0 * edge_pad);
			stage = make_rect(edge_pad, edge_pad, screen_w - dock_w - 2.0 * edge_pad - gutter, screen_h - 2.0 * edge_pad);
		} else {
			dock = make_rect(edge_pad, edge_pad, dock_w, screen_h - 2.0 * edge_pad);
			stage = make_rect(edge_pad + dock_w + gutter, edge_pad, screen_w - dock_w - 2.0 * edge_pad - gutter, screen_h - 2.0 * edge_pad);
		}
	}
	var plan = CockpitPlan { screen_w: screen_w, screen_h: screen_h, layout_id: layout_id, dock_rect: dock, stage_rect: stage, portrait: portrait, dock_bottom: dock_bottom, buttons: [], pods: [] };
	let long_span f32 = if dock_bottom { dock.w } else { dock.h };
	let min_slot f32 = max(min_hit * 0.85, 48.0);
	var btn_gap f32 = max(gutter * 0.65, 7.0);
	var slot f32 = (long_span - 5.0 * btn_gap) / 6.0;
	if slot < min_slot {
		btn_gap = (long_span - 6.0 * min_slot) / 5.0;
		slot = min_slot;
		if btn_gap < 0.0 {
			btn_gap = 0.0;
			slot = long_span / 6.0;
		}
	}
	for i in 6 {
		let along f32 = (i as f32) * (slot + btn_gap);
		let br = if dock_bottom { make_rect(dock.x + along, dock.y + 3.0, slot, dock.h - 6.0) } else { make_rect(dock.x + 3.0, dock.y + along, dock.w - 6.0, slot) };
		plan.buttons.push(HitButton { id: (i + 1) as i32, rect: br, primary: i == 3 });
	}
	let sx f32 = stage.x;
	let sy f32 = stage.y;
	let sw f32 = stage.w;
	let sh f32 = stage.h;
	let g f32 = gutter;
	let zero_c = Circle { cx: 0.0, cy: 0.0, r: 0.0 };
	let k_left i32 = if swap_map_media { 1 } else { 0 };
	let k_right i32 = if swap_map_media { 0 } else { 1 };
	if layout_id == 0 {
		if portrait {
			let dial_d f32 = min(sw * 0.94, (sh - g) * 0.495);
			let dial_x f32 = sx + (sw - dial_d) * 0.5;
			cockpit_add_pod(plan, k_left, 1, dial_x, sy, dial_d, dial_d);
			cockpit_add_pod(plan, k_right, 1, dial_x, sy + sh - dial_d, dial_d, dial_d);
			cockpit_add_pod(plan, 2, 3, sx + 4.0, sy + 4.0, 92.0, 40.0);
			cockpit_add_pod(plan, 3, 3, sx + sw - 96.0, sy + 4.0, 92.0, 40.0);
		} else {
			let dial_d f32 = min(sh * 0.96, (sw - g) * 0.50);
			let dial_y f32 = sy + (sh - dial_d) * 0.5;
			let bw f32 = clamp(sw * 0.21, 108.0, 158.0);
			let bh f32 = clamp(sh * 0.10, 38.0, 48.0);
			let bx f32 = sx + (sw - bw) * 0.5;
			cockpit_add_pod(plan, k_left, 1, sx, dial_y, dial_d, dial_d);
			cockpit_add_pod(plan, k_right, 1, sx + sw - dial_d, dial_y, dial_d, dial_d);
			cockpit_add_pod(plan, 2, 3, bx, sy + 2.0, bw, bh);
			cockpit_add_pod(plan, 3, 3, bx, sy + sh - bh - 2.0, bw, bh);
		}
	} else if layout_id == 1 {
		if portrait {
			let dial_d f32 = min(sw * 0.94, sh * 0.50);
			let map_r f32 = dial_d * 0.5;
			let cx f32 = sx + sw * 0.5;
			let cy f32 = sy + 2.0 + map_r;
			let wing_y f32 = cy + map_r * 0.42;
			let cut = Circle { cx: cx, cy: cy, r: map_r + g };
			cockpit_add_pod(plan, 0, 1, sx + (sw - dial_d) * 0.5, sy + 2.0, dial_d, dial_d);
			cockpit_add_cut(plan, 1, 6, sx, wing_y, sw, sy + sh - wing_y, cut);
			cockpit_add_pod(plan, 2, 3, sx + 6.0, sy + 6.0, 104.0, 42.0);
			cockpit_add_pod(plan, 3, 3, sx + sw - 110.0, sy + 6.0, 104.0, 42.0);
		} else {
			let map_d f32 = min(sh * 0.97, sw * 0.56);
			let map_r f32 = map_d * 0.5;
			let cx f32 = sx + map_d * 0.5;
			let cy f32 = sy + sh * 0.5;
			let cut = Circle { cx: cx, cy: cy, r: map_r + g };
			let right_x f32 = cx + map_r * 0.44;
			cockpit_add_pod(plan, 0, 1, cx - map_r, cy - map_r, map_d, map_d);
			cockpit_add_cut(plan, 1, 5, right_x, sy, sx + sw - right_x, sh, cut);
			cockpit_add_pod(plan, 2, 3, sx + 4.0, sy + 4.0, clamp(sw * 0.125, 108.0, 144.0), 42.0);
			cockpit_add_pod(plan, 3, 3, sx + 4.0, sy + sh - 46.0, clamp(sw * 0.115, 96.0, 132.0), 42.0);
			cockpit_add_pod(plan, 5, 3, sx + sw - 118.0, sy + 10.0, 108.0, 38.0);
		}
	} else if layout_id == 2 {
		let map_d f32 = min(sh * 0.96, sw * 0.54);
		let map_r f32 = map_d * 0.5;
		let cx f32 = sx + map_d * 0.5;
		let cy f32 = sy + sh * 0.5;
		let cut = Circle { cx: cx, cy: cy, r: map_r + g };
		let right_x f32 = cx + map_r * 0.44;
		cockpit_add_pod(plan, 0, 1, cx - map_r, cy - map_r, map_d, map_d);
		cockpit_add_cut(plan, 1, 5, right_x, sy, sx + sw - right_x, sh, cut);
		cockpit_add_pod(plan, 2, 3, sx + 4.0, sy + 4.0, clamp(sw * 0.125, 108.0, 144.0), 42.0);
		cockpit_add_pod(plan, 3, 3, sx + 4.0, sy + sh - 46.0, clamp(sw * 0.115, 96.0, 132.0), 42.0);
	} else if layout_id == 3 {
		let short_side f32 = min(sw, sh);
		let media_d f32 = clamp(short_side * 0.40, 128.0, 210.0);
		cockpit_add_pod(plan, 0, 0, sx, sy, sw, sh);
		cockpit_add_pod(plan, 2, 3, sx + 12.0, sy + 12.0, 112.0, 44.0);
		cockpit_add_pod(plan, 3, 3, sx + 124.0 + g, sy + 12.0, 112.0, 44.0);
		cockpit_add_pod(plan, 1, 1, sx + sw - 12.0 - media_d, sy + sh - 12.0 - media_d, media_d, media_d);
	} else if layout_id == 4 {
		if portrait {
			let first_h f32 = (sh - g) * 0.58;
			let second_y f32 = sy + first_h + g;
			cockpit_add_pod(plan, k_left, 2, sx, sy, sw, first_h);
			cockpit_add_pod(plan, k_right, 2, sx, second_y, sw, sh - g - first_h);
			cockpit_add_pod(plan, 2, 3, sx + sw - 16.0 - 204.0 - g, sy + 14.0, 108.0, 38.0);
			cockpit_add_pod(plan, 3, 3, sx + sw - 16.0 - 96.0, sy + 14.0, 96.0, 38.0);
		} else {
			let first_w f32 = (sw - g) * 0.60;
			let second_x f32 = sx + first_w + g;
			cockpit_add_pod(plan, k_left, 2, sx, sy, first_w, sh);
			cockpit_add_pod(plan, k_right, 2, second_x, sy, sw - g - first_w, sh);
			cockpit_add_pod(plan, 2, 3, sx + first_w - 16.0 - 204.0 - g, sy + 14.0, 108.0, 38.0);
			cockpit_add_pod(plan, 3, 3, sx + first_w - 16.0 - 96.0, sy + 14.0, 96.0, 38.0);
		}
	} else if layout_id == 5 {
		if portrait {
			let top_h f32 = (sh - g) * 0.60;
			cockpit_add_pod(plan, 0, 3, sx, sy, sw, top_h);
			cockpit_add_pod(plan, 1, 3, sx, sy + top_h + g, sw, sh - g - top_h);
			cockpit_add_chips(plan, sx + sw - 8.0, sy + 8.0, g);
		} else {
			let map_w f32 = (sw - g) * 0.60;
			cockpit_add_pod(plan, 0, 3, sx, sy, map_w, sh);
			cockpit_add_pod(plan, 1, 3, sx + map_w + g, sy, sw - g - map_w, sh);
			cockpit_add_chips(plan, sx + map_w - 8.0, sy + 8.0, g);
		}
	} else if layout_id == 6 {
		if portrait {
			let first_h f32 = (sh - g) * 0.62;
			cockpit_add_pod(plan, k_left, 0, sx, sy, sw, first_h);
			cockpit_add_pod(plan, k_right, 0, sx, sy + first_h + g, sw, sh - g - first_h);
		} else {
			let first_w f32 = (sw - g) * 0.62;
			cockpit_add_pod(plan, k_left, 0, sx, sy, first_w, sh);
			cockpit_add_pod(plan, k_right, 0, sx + first_w + g, sy, sw - g - first_w, sh);
		}
		cockpit_add_chips(plan, sx + sw - 8.0, sy + 8.0, g);
	} else if layout_id == 7 {
		if portrait {
			let first_h f32 = (sh - g) * 0.58;
			cockpit_add_pod(plan, k_left, 0, sx, sy, sw, first_h);
			cockpit_add_pod(plan, k_right, 0, sx, sy + first_h + g, sw, sh - g - first_h);
		} else {
			let first_w f32 = (sw - g) * 0.58;
			cockpit_add_pod(plan, k_left, 0, sx, sy, first_w, sh);
			cockpit_add_pod(plan, k_right, 0, sx + first_w + g, sy, sw - g - first_w, sh);
		}
		cockpit_add_chips(plan, sx + sw - 8.0, sy + 8.0, g);
	} else if layout_id == 8 {
		if portrait {
			let first_h f32 = (sh - g) * 0.55;
			cockpit_add_pod(plan, k_left, 0, sx, sy, sw, first_h);
			cockpit_add_pod(plan, k_right, 0, sx, sy + first_h + g, sw, sh - g - first_h);
		} else {
			let first_w f32 = (sw - g) * 0.55;
			cockpit_add_pod(plan, k_left, 0, sx, sy, first_w, sh);
			cockpit_add_pod(plan, k_right, 0, sx + first_w + g, sy, sw - g - first_w, sh);
		}
	} else if layout_id == 9 {
		cockpit_add_pod(plan, 0, 0, sx, sy, sw, sh);
		cockpit_add_chips(plan, sx + sw - 8.0, sy + 8.0, g);
	} else {
		cockpit_add_pod(plan, 6, 0, sx, sy, sw, sh);
		cockpit_add_pod(plan, 2, 3, sx + 8.0, sy + 8.0, 112.0, 40.0);
		cockpit_add_pod(plan, 3, 3, sx + sw - 112.0, sy + 8.0, 104.0, 40.0);
	}
	plan
}
fn validate_cockpit(plan CockpitPlan) int {
	for i in plan.buttons.len {
		if !rect_inside(plan.buttons[i].rect, plan.dock_rect) { return 1; }
	}
	for i in plan.buttons.len {
		for j in i + 1..plan.buttons.len {
			if rects_overlap(plan.buttons[i].rect, plan.buttons[j].rect) { return 2; }
		}
	}
	for i in plan.buttons.len {
		if plan.buttons[i].rect.w < 48.0 || plan.buttons[i].rect.h < 48.0 { return 3; }
	}
	if rects_overlap(plan.dock_rect, plan.stage_rect) { return 4; }
	for i in plan.pods.len {
		if !rect_inside(plan.pods[i].rect, plan.stage_rect) { return 5; }
	}
	0
}
